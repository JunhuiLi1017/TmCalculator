Package: TmCalculator
Type: Package
Title: Scaling Nucleic Acid Thermodynamics from Sequence-Level Calculation to Genome-Wide Profiling
Version: 1.0.5
Date: 2026-05-24
Authors@R: c(
    person(given = "Junhui", family = "Li", email = "ljh.biostat@gmail.com", role = c("cre","aut"),
           comment = c(ORCID = "0000-0003-3973-1700")),
    person("Lihua", "Julie Zhu", , role = c("aut"))
