Package: TmCalculator
Type: Package
Title: Genome-Wide Nucleic Acid Melting Temperature Profiling and Multi-Omics Integration
Version: 1.1.2
Date: 2026-09-23
Authors@R: c(
    person(given = "Junhui", family = "Li", email = "ljh.biostat@gmail.com", role = c("cre","aut"),
           comment = c(ORCID = "0000-0003-3973-1700")),
    person("Lihua Julie", "Zhu", email = "julie.zhu@umassmed.edu", role = c("aut"), comment = c(ORCID = "0000-0001-7416-0590"))
