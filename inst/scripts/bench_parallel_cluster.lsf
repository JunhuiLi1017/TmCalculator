#!/bin/bash
# ===========================================================================
# LSF submission for bench_parallel_cluster.R
#
#   bsub < inst/scripts/bench_parallel_cluster.lsf
#
# PURPOSE. This run is not a search for the saturation point. It repeats the
# laptop sweep (1-6 workers, ~16 GB) on cluster hardware so that the only
# variable between the two tables is the CPU. Worker counts, memory and the
# number of repetitions are therefore matched to the laptop deliberately,
# not chosen to make use of the node.
#
# WHAT REPLACED EXCLUSIVE USE. The earlier version of this file carried -x.
# The long queue rejects exclusive jobs, and taking a whole 40-core node to
# run six workers would idle 34 cores for the length of the job. Instead the
# job asks for six slots and the contention it suffers is *measured* rather
# than prevented: three repetitions give an observed range, and the node
# state is recorded before and after. A narrow range means neighbours did
# not matter; a wide one is a result in itself and tells you to re-run or to
# report the range. The effect under test is large (roughly 45% between
# strategies on the laptop) relative to typical neighbour jitter.
#
# WHY THE MEMORY REQUEST IS NOT 16 GB. An earlier version asked for 16.2 GB
# on the reasoning that the laptop had 16 GB, and the job was killed with
# TERM_MEMLIMIT. The two numbers are not the same quantity. LSF enforces the
# sum of resident set size over every process in the job, and a page shared
# between processes is counted once per process; the laptop had 16 GB of
# physical memory, where a shared page is one page. BSgenome memory-maps the
# hg38 .2bit file, roughly 800 MB, into all seven R processes (one manager,
# six workers): about 0.8 GB of physical memory, but about 5.6 GB against
# the LSF limit. The R session baseline and the Bioconductor shared
# libraries are counted the same way.
#
# Raising the request therefore does not give this job more physical memory
# than the laptop had. It stops the scheduler from killing it on a metric
# that overcounts. The comparison between the two environments rests on
# max_rss_gb, which the R driver measures per worker in both places and
# which is unaffected by what the quota is set to. With the quota at 16.2 GB
# the run produced no measurements at all, so nothing could be compared.
#
# The remaining difference is real and is a result rather than a defect: the
# laptop's demand approached its physical memory and macOS compressed and
# paged, which is what slows the workers and produces the rise in dynamic
# dispatch beyond five workers. This node has 376 GB, so the same demand
# costs nothing. That difference cannot be removed by tightening the quota,
# because Linux under a cgroup limit kills where macOS degrades.
#
# WHAT STILL HAS TO BE PINNED. The cluster is heterogeneous: Xeon Gold 6230,
# EPYC 7702, EPYC 9334 and E5-2699 v4 all accept jobs. Three repetitions
# landing on three CPU families would produce a range that measures the
# scheduler, not the software. The model is therefore fixed below. Gold 6230
# is chosen because there are ~72 such nodes (shortest queue) and because it
# is the closest architectural match to the laptop's Intel Core i7, which is
# what makes "the difference is the CPU" an interpretable statement.
# ===========================================================================
#BSUB -J tmcalc_parbench
#BSUB -q long                 # adjust to a queue whose limit exceeds -W
#BSUB -W 12:00                # 6 worker counts x 3 strategies x 3 reps
#BSUB -n 6                    # matches the laptop's 6 physical cores
#BSUB -R "span[hosts=1]"      # all slots on one machine (PSOCK is node-local)
#BSUB -R "select[model=='x6_420X_IntelRXeonRGold6230CPU210GHz']"
#BSUB -R "rusage[mem=8000]"   # MB per slot; 6 x 8000 = 48 GB. See below.
#BSUB -o logs/parbench.%J.out
#BSUB -e logs/parbench.%J.err

set -euo pipefail

# Everything this job writes goes under the directory bsub was invoked from,
# stated absolutely so the log says where to look rather than "results/".
OUTDIR="$(pwd)/results"
mkdir -p logs "$OUTDIR"

# --- conda environment ---------------------------------------------------
# A batch job starts a fresh non-interactive shell and inherits nothing from
# the interactive session, so the environment has to be activated here.
# `conda activate` alone fails in a non-interactive shell ("run 'conda init'
# first"); sourcing conda.sh is what defines the shell function.
#
# `set +u` is load-bearing: conda's activate reads unset variables, and with
# `set -u` in force the job dies on this line with a message that does not
# mention conda.
#
# There is deliberately no `module load R`. A site R module would take
# precedence on PATH over the conda R that has TmCalculator and the hg38
# BSgenome installed, and the failure mode is not an error but a missing
# package much later in the run.
CONDA_BASE="$(conda info --base 2>/dev/null || echo "$HOME/anaconda3")"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
set +u
conda activate r441_hg38
set -u

# --- fail now, not in four hours -----------------------------------------
echo "R         : $(command -v R)"
R --version | head -1
Rscript -e 'cat("libPaths:\n"); cat(.libPaths(), sep = "\n")'
Rscript -e 'for (p in c("TmCalculator", "BSgenome.Hsapiens.UCSC.hg38",
                        "BiocParallel", "ps"))
              if (!requireNamespace(p, quietly = TRUE)) stop("missing: ", p)
            cat("deps OK; TmCalculator ",
                as.character(packageVersion("TmCalculator")), "\n")'

# --- locate the R driver -------------------------------------------------
# `bsub < file` feeds this script to LSF on stdin, so $0 and BASH_SOURCE do
# not point at the original file and the script cannot find itself. The path
# has to be searched for instead.
#
# The two candidate layouts differ by one directory: R strips the inst/
# prefix at install time, so a source checkout has inst/scripts/ while an
# installed package has scripts/. system.file() is the last resort because
# it costs an R start-up, but it is the only one that works when the job is
# submitted from an unrelated directory.
BENCH_R=""
for p in inst/scripts/bench_parallel_cluster.R \
         scripts/bench_parallel_cluster.R \
         ./bench_parallel_cluster.R; do
  [ -f "$p" ] && { BENCH_R="$p"; break; }
done
if [ -z "$BENCH_R" ]; then
  BENCH_R="$(Rscript -e 'cat(system.file("scripts", "bench_parallel_cluster.R",
                                         package = "TmCalculator"))' \
             2>/dev/null || true)"
fi
if [ ! -f "$BENCH_R" ]; then
  echo "ERROR: cannot locate bench_parallel_cluster.R" >&2
  echo "  submitted from : $(pwd)" >&2
  echo "  looked for     : inst/scripts/, scripts/, ./, and system.file()" >&2
  echo "  fix            : submit from the package root, or install the" >&2
  echo "                   package so that system.file() resolves." >&2
  exit 1
fi
BENCH_R="$(readlink -f "$BENCH_R")"
echo "bench driver  : $BENCH_R"
echo "output dir    : $OUTDIR"
echo

# --- node-local scratch --------------------------------------------------
# LSF sets LSB_JOBTMPDIR on many sites; fall back to /tmp under the job id.
# This must be LOCAL disk. If it resolves to a shared filesystem the whole
# point of staging is lost -- check with `df -T "$SCRATCH"` before trusting
# the numbers.
SCRATCH="${LSB_JOBTMPDIR:-/tmp/$LSB_JOBID}"
mkdir -p "$SCRATCH"
trap 'rm -rf "$SCRATCH"' EXIT

# --- node state, recorded rather than assumed ----------------------------
# Printed before and after the sweep. Without exclusive use these two blocks
# are the evidence for how much company the job had, and they belong in the
# table footnote if the observed range turns out to be wide.
node_state() {
  echo "=== node state ($1) $(date -Is) ==="
  hostname
  uptime                                            # load average
  bhosts -w "$(hostname -s)" 2>/dev/null || true    # slots used on this host
  echo "slots granted : ${LSB_DJOB_NUMPROC:-unset}"
  echo "scratch       : $SCRATCH"
  df -T "$SCRATCH" || true       # confirm local, not nfs/gpfs/lustre
  free -g 2>/dev/null | head -2 || true
  lscpu | grep -E "^(Model name|Socket|Core|Thread)" || true
  echo
}

# --- true physical footprint ---------------------------------------------
# RSS summed over processes is what LSF enforces, and it counts a shared page
# once per process that maps it. PSS divides each shared page by the number
# of processes sharing it, so summing PSS over the job gives the physical
# memory the job actually occupies. The gap between the two is the number a
# reader needs: it is why sizing a request from RSS asks for several times
# what the work requires.
#
# Sampled rather than continuous, so this is a floor on the peak, not the
# peak. The per-worker peak that the comparison with the laptop rests on is
# measured inside the workers by the R driver and reported as max_rss_gb.
# A single sample is one line: unix time, process count, summed RSS, summed
# PSS, all in MB. Sampling runs in the background for the length of the
# sweep, because the interesting moment is mid-run and neither before nor
# after has any workers alive.
MEMLOG="$OUTDIR/mem_sampling.tsv"
mem_sample_once() {
  local pids rss=0 pss=0 n=0 r p
  pids=$(pgrep -u "$USER" -x R 2>/dev/null || true)
  for pid in $pids; do
    r=$(awk '/^Rss:/ {s+=$2} END {print s+0}' "/proc/$pid/smaps_rollup" 2>/dev/null || echo 0)
    p=$(awk '/^Pss:/ {s+=$2} END {print s+0}' "/proc/$pid/smaps_rollup" 2>/dev/null || echo 0)
    rss=$((rss + r)); pss=$((pss + p)); n=$((n + 1))
  done
  printf "%s\t%d\t%d\t%d\n" "$(date +%s)" "$n" "$((rss / 1024))" "$((pss / 1024))"
}
mem_sampler() { while :; do mem_sample_once >> "$MEMLOG"; sleep 10; done; }

mem_report() {
  [ -s "$MEMLOG" ] || { echo "  (no samples)"; return; }
  awk -F'\t' 'NR>1 {
        if ($3 > mr) { mr = $3; mrn = $2 }
        if ($4 > mp) { mp = $4 }
        n++
      }
      END {
        printf "  samples                : %d (10 s apart)\n", n
        printf "  peak sum of RSS        : %d MB   <- what LSF enforces\n", mr
        printf "  peak sum of PSS        : %d MB   <- physical memory used\n", mp
        if (mp > 0) printf "  overcount factor       : %.2fx\n", mr / mp
        printf "  R processes at RSS peak: %d\n", mrn
      }' "$MEMLOG"
  echo "  per-sample log         : $MEMLOG"
}
node_state "before"

# --- memory sampler, running alongside the sweep -------------------------
printf "unix_time\tn_proc\trss_mb\tpss_mb\n" > "$MEMLOG"
mem_sampler &
SAMPLER_PID=$!
# Replaces the earlier scratch-only trap; the sampler must be reaped whether
# the sweep succeeds, fails, or is killed on the wall-clock limit.
trap 'kill "$SAMPLER_PID" 2>/dev/null || true; rm -rf "$SCRATCH"' EXIT

# --- run -----------------------------------------------------------------
# --workers is given explicitly. The script's automatic sweep leaves one core
# for the manager, so -n 6 would produce 1-5 and the table would silently be
# missing the 6-worker row that the laptop has.
Rscript "$BENCH_R" \
  --outdir "$OUTDIR" \
  --reps 3 \
  --segsize 50e6 \
  --workers 1,2,3,4,5,6 \
  --scratch "$SCRATCH"

kill "$SAMPLER_PID" 2>/dev/null || true

echo "=== memory footprint over the sweep ==="
mem_report
echo

node_state "after"
echo "done: $(date)"
