#!/bin/bash
# ===========================================================================
# LSF submission for bench_tm_calculate.R
#
#   bsub < inst/scripts/bench_tm_calculate.lsf
#
# Times the shipped tm_calculate() over one to six workers on hg38, matching
# the laptop sweep so that the only variable between the two tables is the
# hardware. Worker counts, memory and repetitions are therefore chosen to
# match the laptop, not to make use of the node.
#
# WHY SIX SLOTS AND 16 GB. The laptop has six physical cores and 16 GB, and
# this run asks for the same, so that the two environments differ in their
# processors and not in their quota.
#
# An earlier attempt at 16 GB, before the profiling path existed, was killed with
# TERM_MEMLIMIT: the hand-rolled dispatch it replaced returned each task's
# GRanges with its sequence and complement columns intact, and six PSOCK
# workers plus their manager reached about 23 GB. tm_calculate() drops those
# columns in the worker, and the same sweep at 48 GB then peaked at 15.5 GB
# over thirteen processes. That is what makes 16 GB worth asking for now.
#
# LSF enforces resident set size summed over every process in the job, and
# rusage[mem=] is per slot at this site, so 6 x 2667 MB is the 16 GB total.
# The margin over the measured peak is about 3%, which is thin: if this job
# comes back TERM_MEMLIMIT, that is a result rather than a mistake, and the
# 48 GB configuration in git history is the one to fall back to. Worker
# counts run downwards below for that reason, so a job that cannot fit dies
# in its first two minutes rather than in its last hour.
#
# PSOCK workers are independent processes that each attach the packages and
# build their own sequences, so the summed RSS is real rather than an
# artefact of counting shared pages more than once: measured on this
# workload, summed PSS tracks summed RSS to 1.002x.
#
# WHY THE CPU MODEL IS PINNED. The cluster is heterogeneous, and three
# repetitions landing on three CPU families would produce a range that
# measures the scheduler rather than the software. Gold 6230 is the closest
# architectural match to the laptop's Core i7, which is what makes "the
# difference is the hardware" an interpretable statement.
#
# WHY NOT EXCLUSIVE. The long queue rejects -x, and taking a 40-core node to
# run six workers would idle 34 cores for hours. The contention is measured
# rather than prevented: three repetitions give an observed range, and the
# node state is recorded before and after. A narrow range means the
# neighbours did not matter; a wide one is a result and belongs in the
# footnote.
# ===========================================================================
#BSUB -J tmcalc_bench16
#BSUB -q long                 # adjust to a queue whose limit exceeds -W
#BSUB -W 12:00                # 6 worker counts x 3 reps, ~10 min at 1 worker
#BSUB -n 6                    # matches the laptop's 6 physical cores
#BSUB -R "span[hosts=1]"      # all slots on one machine (PSOCK is node-local)
#BSUB -R "select[model=='x6_420X_IntelRXeonRGold6230CPU210GHz']"
#BSUB -R "rusage[mem=2667]"   # MB per slot; 6 x 2667 = 16 GB. See above.
#BSUB -o logs/tmcalc16.%J.out
#BSUB -e logs/tmcalc16.%J.err

set -euo pipefail

# Everything this job writes goes under the directory bsub was invoked from,
# stated absolutely so the log says where to look rather than "results/".
OUTDIR="$(pwd)/results_16g"
mkdir -p logs "$OUTDIR"

# --- conda environment ---------------------------------------------------
# A batch job starts a fresh non-interactive shell and inherits nothing from
# the interactive session. `conda activate` alone fails there ("run 'conda
# init' first"); sourcing conda.sh is what defines the shell function.
# `set +u` is load-bearing: conda's activate reads unset variables and the
# job would die on that line with a message that never mentions conda.
#
# There is deliberately no `module load R`: a site R module would take
# precedence on PATH over the conda R that has TmCalculator and the hg38
# BSgenome installed, and the failure mode is not an error but a missing
# package much later in the run.
CONDA_BASE="$(conda info --base 2>/dev/null || echo "$HOME/anaconda3")"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
set +u
conda activate r441_hg38
set -u

# --- fail now, not in four hours -----------------------------------------
echo "R         : $(command -v R)"
R --version | head -1
Rscript -e 'for (p in c("TmCalculator", "BSgenome.Hsapiens.UCSC.hg38",
                        "BiocParallel"))
              if (!requireNamespace(p, quietly = TRUE)) stop("missing: ", p)
            if (!"regions" %in% names(formals(TmCalculator::tm_calculate)))
              stop("this TmCalculator predates the merged tm_calculate()")
            cat("deps OK; TmCalculator ",
                as.character(packageVersion("TmCalculator")), "\n")'

# --- locate the R driver -------------------------------------------------
# `bsub < file` feeds this script to LSF on stdin, so $0 does not point at
# the original file and the script cannot find itself. A source checkout has
# inst/scripts/ and an installed package has scripts/, R having stripped the
# inst/ prefix; system.file() is last because it costs an R start-up, but it
# is the only one that works from an unrelated directory.
BENCH_R=""
for p in inst/scripts/bench_tm_calculate.R \
         scripts/bench_tm_calculate.R \
         ./bench_tm_calculate.R; do
  [ -f "$p" ] && { BENCH_R="$p"; break; }
done
if [ -z "$BENCH_R" ]; then
  BENCH_R="$(Rscript -e 'cat(system.file("scripts", "bench_tm_calculate.R",
                                         package = "TmCalculator"))' \
             2>/dev/null || true)"
fi
if [ ! -f "$BENCH_R" ]; then
  echo "ERROR: cannot locate bench_tm_calculate.R" >&2
  echo "  submitted from : $(pwd)" >&2
  echo "  looked for     : inst/scripts/, scripts/, ./, and system.file()" >&2
  echo "  fix            : submit from the package root, or install the" >&2
  echo "                   package so that system.file() resolves." >&2
  exit 1
fi
BENCH_R="$(readlink -f "$BENCH_R")"
echo "bench driver  : $BENCH_R"
echo "output dir    : $OUTDIR"
echo

# --- node-local scratch --------------------------------------------------
# Used for tm_calculate's tmpdir. It must be LOCAL disk: if it resolves to a
# shared filesystem the staging path is measuring the network. Check with
# `df -T "$SCRATCH"` in the log before trusting any sequence-input timing.
SCRATCH="${LSB_JOBTMPDIR:-/tmp/$LSB_JOBID}"
mkdir -p "$SCRATCH"
trap 'rm -rf "$SCRATCH"' EXIT

# --- node state, recorded rather than assumed ----------------------------
node_state() {
  echo "=== node state ($1) $(date -Is) ==="
  hostname
  uptime                                            # load average
  bhosts -w "$(hostname -s)" 2>/dev/null || true    # slots used on this host
  echo "slots granted : ${LSB_DJOB_NUMPROC:-unset}"
  echo "scratch       : $SCRATCH"
  df -T "$SCRATCH" || true       # confirm local, not nfs/gpfs/lustre
  free -g 2>/dev/null | head -2 || true
  lscpu | grep -E "^(Model name|Socket|Core|Thread)" || true
  echo
}

# --- memory sampling -----------------------------------------------------
# tm_calculate() has no hook inside its tasks and is not going to grow one for
# a benchmark, so memory is measured from outside. Three numbers per sample:
#
#   rss_mb   summed over the job's R processes. This is what LSF enforces.
#   pss_mb   the same sum with each shared page divided among its sharers,
#            so this is the physical memory the job really occupies. On this
#            workload the two agree to 1.002x, which says PSOCK workers share
#            essentially nothing; a forked backend would separate them, and
#            anyone sizing a request needs to know which case they are in.
#   max1_mb  the largest single R process. This is the per-worker figure the
#            comparison with the laptop rests on, and the one the R driver
#            joins onto each run by timestamp.
#
# Sampled every 10 s, so all three are floors on the peak rather than the
# peak. Sampling runs for the length of the sweep because the interesting
# moment is mid-run, and neither before nor after has any workers alive.
MEMLOG="$OUTDIR/mem_sampling.tsv"
mem_sample_once() {
  local pids rss=0 pss=0 max1=0 n=0 r p
  pids=$(pgrep -u "$USER" -x R 2>/dev/null || true)
  for pid in $pids; do
    r=$(awk '/^Rss:/ {s+=$2} END {print s+0}' "/proc/$pid/smaps_rollup" 2>/dev/null || echo 0)
    p=$(awk '/^Pss:/ {s+=$2} END {print s+0}' "/proc/$pid/smaps_rollup" 2>/dev/null || echo 0)
    rss=$((rss + r)); pss=$((pss + p)); n=$((n + 1))
    [ "$r" -gt "$max1" ] && max1=$r
  done
  printf "%s\t%d\t%d\t%d\t%d\n" "$(date +%s)" "$n" \
         "$((rss / 1024))" "$((pss / 1024))" "$((max1 / 1024))"
}
mem_sampler() { while :; do mem_sample_once >> "$MEMLOG"; sleep 10; done; }

mem_report() {
  [ -s "$MEMLOG" ] || { echo "  (no samples)"; return; }
  awk -F'\t' 'NR>1 {
        if ($3 > mr) { mr = $3; mrn = $2 }
        if ($4 > mp) { mp = $4 }
        if ($5 > m1) { m1 = $5 }
        n++
      }
      END {
        printf "  samples                 : %d (10 s apart)\n", n
        printf "  peak sum of RSS         : %d MB   <- what LSF enforces\n", mr
        printf "  peak sum of PSS         : %d MB   <- physical memory used\n", mp
        if (mp > 0) printf "  RSS / PSS               : %.3fx\n", mr / mp
        printf "  peak single R process   : %d MB   <- per-worker figure\n", m1
        printf "  R processes at RSS peak : %d\n", mrn
      }' "$MEMLOG"
  echo "  per-sample log          : $MEMLOG"
}

node_state "before"

printf "unix_time\tn_proc\trss_mb\tpss_mb\tmax1_mb\n" > "$MEMLOG"
mem_sampler &
SAMPLER_PID=$!
# Replaces the scratch-only trap; the sampler must be reaped whether the
# sweep succeeds, fails, or is killed on the wall-clock limit.
trap 'kill "$SAMPLER_PID" 2>/dev/null || true; rm -rf "$SCRATCH"' EXIT

# --- run -----------------------------------------------------------------
# --workers is given explicitly. Deriving it from the slot count would leave
# one core for the manager and produce 1-5, silently dropping the 6-worker
# row that the laptop table has.
# Worker counts descend so that the heaviest configuration is attempted
# first: at a 16 GB quota with a 15.5 GB measured peak, a job that does not
# fit should fail in minutes rather than after the cheap configurations have
# already consumed an hour. The summary table is reordered by worker count
# regardless of the order they were run in.
Rscript "$BENCH_R" \
  --outdir  "$OUTDIR" \
  --workers 6,5,4,3,2,1 \
  --reps    3 \
  --window  200 \
  --slide   200 \
  --unit    segment \
  --segsize 50e6 \
  --genome  BSgenome.Hsapiens.UCSC.hg38 \
  --regions chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY \
  --nn-table DNA_NN_Breslauer_1986 \
  --na      50 \
  --memlog  "$MEMLOG" \
  --tmpdir  "$SCRATCH"

kill "$SAMPLER_PID" 2>/dev/null || true

echo
echo "=== memory footprint over the whole sweep ==="
mem_report
echo
echo "Per-run memory is joined onto bench_tm_calculate.csv by timestamp;"
echo "this block is the envelope over every run together."
echo

node_state "after"
echo "done: $(date)"
